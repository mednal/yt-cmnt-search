{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"],
    // esbuild emits the bundles (scripts/build.mjs); tsc only typechecks, so
    // imports can carry the .ts extension that Node's test runner needs.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src"]
}
