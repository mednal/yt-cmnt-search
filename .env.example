# Backend
PORT=3000

# PostgreSQL (M2) - docker-compose publishes the container on 5433 so it does
# not clash with a Postgres already installed on the host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/youtube_comment_ai

# YouTube Data API v3 (M3)
YOUTUBE_API_KEY=

# Embeddings (M5). Runs locally: no API key, no quota, no cost. The model is
# downloaded once (~130MB) into the Transformers.js cache on first use.
# Changing this to a model of a different width needs a schema migration —
# comments.embedding is vector(384).
EMBEDDING_MODEL=Xenova/gte-small

# Optional: only used if OpenAIEmbeddingProvider is bound in EmbeddingModule
# instead of the local one (which also requires a migration to vector(1536)).
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
